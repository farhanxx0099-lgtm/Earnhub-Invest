<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EarnHub Invest</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#0b1020;color:#fff}.hidden{display:none}
.box{padding:20px;max-width:450px;margin:auto}
.input{width:100%;padding:12px;margin:8px 0;background:#151b30;border:1px solid #303957;color:#fff;border-radius:10px}
.btn{width:100%;padding:12px;margin:8px 0;background:#6b4eff;color:#fff;border:0;border-radius:10px;font-weight:700;cursor:pointer}
.btn-green{background:#00c853}
.card{background:#151b30;padding:18px;border-radius:15px;margin:10px 0}
</style>
</head>
<body>

<div id="auth" class="box">
<h2>EarnHub Invest</h2>
<input id="email" class="input" placeholder="Email">
<input id="pass" class="input" type="password" placeholder="Password">
<input id="ref" class="input" placeholder="Referral Code Optional">
<button class="btn" onclick="signup()">Register</button>
<button class="btn" onclick="login()">Login</button>
</div>

<div id="app" class="box hidden">
<h2>Balance: Rs <span id="bal">0</span></h2>

<div class="card">
<h3>1. Deposit</h3>
<p>Admin JazzCash/Easypaisa: <b id="adminNum">0300-1234567</b> <button onclick="copy('03001234567')">Copy</button></p>
<input id="d_amt" class="input" type="number" placeholder="Kitne bhej rahe ho">
<input id="d_num" class="input" placeholder="Apna JazzCash Number">
<input type="file" id="d_ss" class="input" accept="image/*">
<button class="btn btn-green" onclick="submitDeposit()">Screenshot Upload & Submit</button>
</div>

<div class="card">
<h3>2. Investment Plans</h3>
<p><b>500</b> = 50 Daily x 30 Days</p><button class="btn" onclick="buyPlan(500,50)">Activate</button>
<p><b>1000</b> = 100 Daily x 30 Days</p><button class="btn" onclick="buyPlan(1000,100)">Activate</button>
<p><b>3000</b> = 350 Daily x 30 Days</p><button class="btn" onclick="buyPlan(3000,350)">Activate</button>
<p><b>5000</b> = 600 Daily x 30 Days</p><button class="btn" onclick="buyPlan(5000,600)">Activate</button>
<div id="myplan"></div>
</div>

<div class="card">
<h3>3. Withdraw</h3>
<input id="w_num" class="input" placeholder="JazzCash/Easypaisa Number">
<button class="btn" onclick="submitWithdraw()">Withdraw Request</button>
</div>

<div class="card">
<h3>4. Referral - Earn 10%</h3>
<p>Your Code: <b id="mycode"></b> <button onclick="copy(document.getElementById('mycode').innerText)">Copy</button></p>
</div>

<button class="btn" style="background:#f00" onclick="logout()">Logout</button>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";
import { getAuth, createUserWithEmailAndPassword, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-auth.js";
import { getFirestore, doc, getDoc, setDoc, updateDoc, addDoc, collection, query, where, getDocs, serverTimestamp, increment } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-firestore.js";
import { getStorage, ref, uploadBytes, getDownloadURL } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-storage.js";

const firebaseConfig={apiKey:"AIzaSyAcPDFKm48dBxMOh9ESO3LusFcrTIKJc8M",authDomain:"earnhub-d31f7.firebaseapp.com",projectId:"earnhub-d31f7",storageBucket:"earnhub-d31f7.appspot.com"};
const app=initializeApp(firebaseConfig); const auth=getAuth(); const db=getFirestore(); const storage=getStorage();
let uid="";

onAuthStateChanged(auth,async u=>{ if(u){uid=u.uid; document.getElementById('auth').classList.add('hidden'); document.getElementById('app').classList.remove('hidden'); loadUser();} });

window.signup=async()=>{ let res=await createUserWithEmailAndPassword(auth,email.value,pass.value); await setDoc(doc(db,"users",res.user.uid),{balance:0,referrals:0,referralCode:res.user.uid.slice(0,6),referredBy:ref.value,plan:null}); }
window.login=()=>signInWithEmailAndPassword(auth,email.value,pass.value);
window.logout=()=>signOut(auth);

async function loadUser(){ let d=await getDoc(doc(db,"users",uid)); let data=d.data(); bal.innerText=data.balance; mycode.innerText=data.referralCode; checkProfit(data); showPlan(data.plan); }

function checkProfit(data){ if(data.plan && Date.now()-data.plan.last>86400000 && data.plan.days>0){ updateDoc(doc(db,"users",uid),{balance:increment(data.plan.daily),"plan.last":Date.now(),"plan.days":increment(-1)}); if(data.plan.days<=1) updateDoc(doc(db,"users",uid),{plan:null}); }}

window.buyPlan=(amt,daily)=>{ updateDoc(doc(db,"users",uid),{plan:{amount:amt,daily:daily,days:30,last:Date.now()}}); alert("Plan Activated"); loadUser(); }

function showPlan(p){ myplan.innerHTML = p ? `<p style="color:#0f0">Active: Rs${p.amount} = ${p.daily}/day. Days left: ${p.days}</p>` : `<p>No Active Plan</p>` }

window.submitDeposit=async()=>{
  let file=d_ss.files[0]; if(!file){alert("Screenshot upload karo");return;}
  let storageRef=ref(storage,`deposits/${uid}/${Date.now()}.jpg`);
  let snap=await uploadBytes(storageRef,file); let url=await getDownloadURL(snap.ref);
  await addDoc(collection(db,"deposits"),{uid:uid,amount:parseInt(d_amt.value),number:d_num.value,ss:url,status:"pending",time:serverTimestamp()});
  alert("Request Sent. Admin approve karega");
}

window.submitWithdraw=async()=>{
  let d=await getDoc(doc(db,"users",uid)); if(d.data().balance<100){alert("Min 100");return;}
  await addDoc(collection(db,"withdraws"),{uid:uid,amount:d.data().balance,number:w_num.value,status:"pending",time:serverTimestamp()});
  await updateDoc(doc(db,"users",uid),{balance:0}); alert("Withdraw request sent");
}

window.copy=(t)=>{navigator.clipboard.writeText(t); alert("Copied: "+t)}
</script>
</body>
</html>
